<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless test harness for the Stakeholders simulation core.
    Compiles Assets/Stakeholders/Core directly (it has no Unity dependencies) and runs
    whole games with AI partners for balance, fuzz and serialization testing.
    Usage (after a separator argument): balance [seeds] [ai], passive [seeds], fuzz [seeds], serialize, all
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS0162;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Stakeholders/Core/**/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
